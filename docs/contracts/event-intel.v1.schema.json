{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fundlive.local/schemas/event-intel.v1.schema.json",
  "title": "FundLive Event Intelligence Shadow Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "producer", "generated_at", "as_of", "events"],
  "properties": {
    "schema_version": {
      "const": "event-intel.v1"
    },
    "mode": {
      "const": "shadow"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "run_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "event_type",
        "event_status",
        "title",
        "summary",
        "impact",
        "strength",
        "horizon",
        "known_at",
        "known_at_basis",
        "source",
        "targets"
      ],
      "properties": {
        "external_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "event_type": { "type": "string", "minLength": 1, "maxLength": 48 },
        "event_status": {
          "enum": ["expected", "disclosed", "active", "expired", "cancelled"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "impact": { "enum": ["positive", "negative", "neutral", "mixed"] },
        "strength": { "enum": ["high", "medium", "low"] },
        "horizon": { "enum": ["immediate", "short", "medium", "long"] },
        "expected_at": { "type": "string", "format": "date-time" },
        "announced_at": { "type": "string", "format": "date-time" },
        "effective_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "known_at": { "type": "string", "format": "date-time" },
        "known_at_basis": {
          "enum": ["source_published_at", "source_updated_at", "first_seen"]
        },
        "source": { "$ref": "#/$defs/source" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/target" }
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "inference": { "$ref": "#/$defs/inference" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "name", "url", "published_at", "confidence"],
      "properties": {
        "tier": {
          "enum": ["official", "official_aggregator", "secondary", "heuristic"]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "published_at": { "type": "string", "format": "date-time" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_type", "asset_code", "mapping_basis"],
      "properties": {
        "asset_type": {
          "enum": ["fund", "index", "stock", "sector", "theme", "macro"]
        },
        "asset_code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "mapping_basis": { "type": "string", "minLength": 1, "maxLength": 256 },
        "weight_hint": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "published_at"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "published_at": { "type": "string", "format": "date-time" },
        "excerpt": { "type": "string", "maxLength": 2000 }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "confidence", "rationale"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
